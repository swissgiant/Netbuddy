# NetBuddy Produktion — kopieren nach .env.prod und ausfüllen. NICHT committen.

# --- Postgres ---
POSTGRES_USER=netbuddy
POSTGRES_PASSWORD=BITTE-STARKES-PASSWORT-SETZEN
POSTGRES_DB=netbuddy

# --- App ---
APP_NAME=NetBuddy
LOG_LEVEL=INFO
# Fernet-Key für die Credential-Verschlüsselung — EINMALIG erzeugen und sicher aufbewahren:
#   docker run --rm ghcr.io/astral-sh/uv:python3.12-bookworm-slim \
#     uvx --from cryptography python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# (oder lokal: uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# ACHTUNG: Key-Verlust = alle gespeicherten Geräte-Passwörter unlesbar.
FERNET_KEY=HIER-DEN-ERZEUGTEN-KEY-EINTRAGEN

# Geplante Discovery (Minuten; 0 = aus) + automatische Namensauflösung danach.
SCHEDULED_DISCOVERY_MINUTES=30
SCHEDULED_RESOLVE_HOSTS=true

# DATABASE_URL / REDIS_URL / USE_SECURE_COOKIES setzt das Compose automatisch.
